{
  "name": "ts-api-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "build": "tsc",
    "start": "node src/index.ts",
    "worker": "node src/application/worker.ts",
    "worker:dev": "node --watch src/application/worker.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 --test-timeout=3600000 \"../tests/integration/*.test.ts\"",
    "test:e2e": "node src/test_e2e.ts",
    "ingest-pubmed": "node scripts/ingest_pubmed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@duckdb/node-api": "1.5.5-r.3",
    "@temporalio/activity": "^1.11.4",
    "@temporalio/client": "^1.11.4",
    "@temporalio/worker": "^1.11.4",
    "@temporalio/workflow": "^1.11.4",
    "ai": "^4.0.22",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.21.1",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
