{
  "name": "genomic-vcf-ingestion-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Genomic VCF Ingestion & AI Insight Engine monorepo",
  "workspaces": [
    "ts-api-agent"
  ],
  "scripts": {
    "build:rust": "cargo build --release --manifest-path rust-ingestion-worker/Cargo.toml",
    "build:ts": "npm run build --workspace=ts-api-agent",
    "dev:ts": "npm run dev --workspace=ts-api-agent",
    "test:ts": "npm run test --workspace=ts-api-agent",
    "test:rust": "cargo test --manifest-path rust-ingestion-worker/Cargo.toml",
    "test": "npm run test:ts && npm run test:rust",
    "test:integration": "npm run test:integration --workspace=ts-api-agent"
  }
}
